<!--
 ~ Schema registry converters for the Kafka Connect image, one plugin jar per registry and format:
 ~   apicurio/avro, apicurio/protobuf, confluent/avro, confluent/protobuf
 ~ Build: mvn -B package; each jar is <registry>/<format>/target/<artifactId>-<registry version>.jar
 ~
 ~ Allowlist build: every dependency is managed here with <exclusion>*:*</exclusion>, so nothing
 ~ enters a jar transitively; a jar holds exactly the artifacts its poms list. The lists are the
 ~ static (jdeps) closure of the converters, minus what Kafka Connect already has.
 ~
 ~ Not bundled, taken from $KAFKA_HOME/libs: kafka-clients, connect-api, Jackson core/databind/
 ~ annotations/jdk8/yaml/csv, slf4j-api, swagger-annotations, jakarta.* APIs, jspecify,
 ~ commons-validator/logging/beanutils/digester/collections, lz4/snappy/zstd. The Connect
 ~ PluginClassLoader is child-first and falls back to the worker classpath for anything the plugin
 ~ lacks; org.apache.kafka.* and org.slf4j.* always come from the worker.
 ~ Not bundled at all: annotation-only jars (jsr305, findbugs annotations, error_prone, j2objc,
 ~ checker-qual, jetbrains annotations).
 ~
 ~ One version per library for both registries. Versions are the registries' own, raised only to
 ~ fix a CVE (marked) or to align the two registries on the newer one.
 ~
 ~ tools/PomProperties.java writes META-INF/maven/**/pom.properties for bundled jars built without
 ~ Maven (Gradle, Bazel), so vulnerability scanners can identify them inside the uber jar.
 ~ tools/ThirdPartyLicenses.java writes the plugin jars' part of LICENSE-3rdPARTIES.txt: run it
 ~ after any change of a version or a dependency list (usage in its class comment).
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>solutions.a2.oracle</groupId>
	<artifactId>schema-registry-clients</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Schema registry converters for Kafka Connect</name>

	<modules>
		<module>apicurio</module>
		<module>confluent</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- registries -->
		<apicurio.version>3.3.5</apicurio.version>
		<!-- 8.4.x: built on kafka-clients 4.4 (8.1.x calls org.apache.kafka.common.utils.ByteUtils, gone in Kafka 4.4) -->
		<confluent.version>8.4.1</confluent.version>
		<!-- Apicurio REST client -->
		<kiota.version>1.9.3</kiota.version>
		<kiota.http.version>0.0.39</kiota.http.version>
		<uritemplate.version>2.0.0</uritemplate.version>
		<!-- Apicurio 3.3.5: 1.57.0, CVE-2026-45292, CVE-2026-118259 -->
		<otel.version>1.68.0</otel.version>
		<!-- Confluent REST client -->
		<httpclient5.version>5.6.4</httpclient5.version>
		<!-- 5.4.2: CVE-2026-54399, CVE-2026-54428 -->
		<httpcore5.version>5.4.3</httpcore5.version>
		<!-- Confluent data contract rules and field encryption -->
		<cel.version>0.13.1</cel.version>
		<antlr4.version>4.13.2</antlr4.version>
		<re2j.version>1.8</re2j.version>
		<threeten.extra.version>1.8.0</threeten.extra.version>
		<jsonata4java.version>2.6.4</jsonata4java.version>
		<commons.text.version>1.15.0</commons.text.version>
		<jackson.protobuf.version>0.9.18</jackson.protobuf.version>
		<!-- jackson-databind itself comes from $KAFKA_HOME/libs: Jackson modules must match its version -->
		<jackson.version>2.21.7</jackson.version>
		<tink.version>1.24.0</tink.version>
		<!-- Avro -->
		<avro.version>1.12.2</avro.version>
		<commons.compress.version>1.28.0</commons.compress.version>
		<commons.codec.version>1.22.1</commons.codec.version>
		<commons.io.version>2.21.0</commons.io.version>
		<commons.lang3.version>3.20.0</commons.lang3.version>
		<!-- Protobuf -->
		<protobuf.version>4.36.2</protobuf.version>
		<proto.common.version>2.75.0</proto.common.version>
		<wire.version>6.4.7</wire.version>
		<okio.version>3.18.2</okio.version>
		<kotlin.version>2.4.21</kotlin.version>
		<kotlinx.datetime.version>0.8.0-0.6.x-compat</kotlinx.datetime.version>
		<kotlinpoet.version>2.2.0</kotlinpoet.version>
		<javapoet.version>0.12.0</javapoet.version>
		<gson.version>2.13.2</gson.version>
		<!-- Apicurio 3.3.5: 33.5.0-jre, Confluent 8.4.1: 32.0.1-jre; CVE-2026-102554 -->
		<guava.version>33.7.2-jre</guava.version>
		<failureaccess.version>1.0.3</failureaccess.version>
		<!-- build -->
		<dependency.plugin.version>3.11.0</dependency.plugin.version>
		<exec.plugin.version>3.7.0</exec.plugin.version>
		<shade.plugin.version>3.6.2</shade.plugin.version>
		<license.plugin.version>2.5.0</license.plugin.version>
	</properties>

