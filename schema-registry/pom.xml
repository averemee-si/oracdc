			<dependency><groupId>io.github.std-uritemplate</groupId><artifactId>std-uritemplate</artifactId><version>${uritemplate.version}</version><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
