	<build>
		<!-- converter.version: set by apicurio/pom.xml and confluent/pom.xml -->
		<finalName>${project.artifactId}-${converter.version}</finalName>
		<pluginManagement>
			<plugins>
				<!-- every plugin jar module lists these three, in this order -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>${dependency.plugin.version}</version>
					<executions>
						<execution>
							<id>bundle-classpath</id>
							<phase>prepare-package</phase>
							<goals><goal>build-classpath</goal></goals>
							<configuration>
								<includeScope>runtime</includeScope>
								<outputProperty>bundle.classpath</outputProperty>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec.plugin.version}</version>
					<executions>
						<execution>
							<id>pom-properties</id>
							<phase>prepare-package</phase>
							<goals><goal>exec</goal></goals>
							<configuration>
								<executable>${java.home}/bin/java</executable>
								<arguments>
									<argument>${project.basedir}/../../tools/PomProperties.java</argument>
									<argument>${settings.localRepository}</argument>
									<argument>${project.build.outputDirectory}</argument>
									<argument>${bundle.classpath}</argument>
								</arguments>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-shade-plugin</artifactId>
					<version>${shade.plugin.version}</version>
					<executions>
						<execution>
							<id>uber-jar</id>
							<phase>package</phase>
							<goals><goal>shade</goal></goals>
							<configuration>
								<createDependencyReducedPom>false</createDependencyReducedPom>
								<filters>
									<filter>
										<artifact>*:*</artifact>
										<excludes>
											<exclude>module-info.class</exclude>
											<exclude>META-INF/versions/*/module-info.class</exclude>
											<exclude>META-INF/*.SF</exclude>
											<exclude>META-INF/*.DSA</exclude>
											<exclude>META-INF/*.RSA</exclude>
											<exclude>META-INF/*.EC</exclude>
										</excludes>
									</filter>
								</filters>
								<transformers>
									<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
									<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
									<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
									<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
										<manifestEntries>
											<Multi-Release>true</Multi-Release>
											<Implementation-Title>${project.name}</Implementation-Title>
											<Implementation-Version>${converter.version}</Implementation-Version>
											<Implementation-Vendor>A2 Rešitve d.o.o.</Implementation-Vendor>
										</manifestEntries>
									</transformer>
								</transformers>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<!-- mvn license:aggregate-add-third-party, input of tools/ThirdPartyLicenses.java -->
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>license-maven-plugin</artifactId>
					<version>${license.plugin.version}</version>
					<configuration>
						<excludedScopes>test,provided</excludedScopes>
						<thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
